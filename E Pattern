import java.util.Scanner;
public class Main {
	public static void main(String[] args) {
		Scanner s = new Scanner(System.in);
		int n = s.nextInt();
		for (int i = 0; i < n; i++) {
			System.out.print("*");
			if (i == 0 || i == n/2 || i == n-1) {
				for (int j = 1; j < n-1; j++) {
					System.out.print(" *");
				}
			}
			System.out.println();
		}
	}
}
