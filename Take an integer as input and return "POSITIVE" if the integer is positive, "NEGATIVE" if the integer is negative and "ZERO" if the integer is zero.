import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner s = new Scanner(System.in);
      System.out.println("");
      int Number = s.nextInt();
      if(Number > 0)
        System.out.println("POSITIVE");
      else if(Number < 0)
        System.out.println("NEGATIVE");
      else
        System.out.println("ZERO");
  }
}
