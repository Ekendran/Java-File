import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        
        int t = s.nextInt();
        int n = s.nextInt();
        int m = s.nextInt();
        
        int[][][] a = new int[t][n][m];
        
        for (int k = 0; k < t; k++) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < m; j++) {
                    a[k][i][j] = s.nextInt();
                }
            }
        }

     
        for (int k = 0; k < t; k++) {
            for (int i = 0; i < n; i++) {
                for (int j = 0; j < m; j++) {
                    System.out.print(a[k][i][j] + " ");
                }
                System.out.println(); 
            }
            System.out.println();
        }

        s.close(); 
    }
}
