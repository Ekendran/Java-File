import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner s = new Scanner(System.in);
	    int n = s.nextInt();
	    int a[] = new int[n];
	    int ind = -1;
	    for(int i = 0; i < n; i++){
	        a[i] = s.nextInt();
	    }
	    int k = s.nextInt();
	    for(int i = 0; i < n; i++){
	        if(a[i] == k){
	            ind = i;
	            break;
	        }
	    }
	    if(ind!=0){
	        System.out.print("key number "+k+"->index: "+ind);
	    }
	    else{
	        System.out.print("no key number");
	    }
	}
}
