import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner s = new Scanner(System.in);
	    int n = s.nextInt();
	    int a[] = new int[n];
	    for(int i = 0; i < n; a[i++]=s.nextInt());
	    for(int i = 0; i < n - 1; i+=2){
	        int t = a[i];
	        a[i] = a[i+1];
	        a[i+1] = t;
	    }
	    for(int i = 0; i < n; i++)
	    System.out.print(a[i]+" ");
	}
}
